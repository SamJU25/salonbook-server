# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/salonbook?retryWrites=true&w=majority

# Better Auth / JWT Verification
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-32-char-minimum-random-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ImgBB Image Hosting
IMGBB_API_KEY=your_imgbb_api_key

# Seed Admin Account (used only by npm run seed)
SEED_ADMIN_NAME=SalonBook Admin
SEED_ADMIN_EMAIL=admin@salonbook.com
SEED_ADMIN_PASSWORD=Admin@1234
